{
  "expo": {
    "name": "zgubione-znalezione",
    "slug": "zgubione-znalezione",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zgubione-znalezione",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
